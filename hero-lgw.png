const DEFAULT={
site:{company:"LOYOLA GLOBAL WORKS",tagline:"CONNECTING TALENT. POWERING BUSINESS.",heroKicker:"GLOBAL TALENT. REAL IMPACT.",heroTitle:"Connecting Talent. Powering Business.",heroText:"Loyola Global Works helps businesses build stronger teams through exceptional global talent and dependable outsourcing solutions.",aboutTitle:"People. Purpose. Performance.",aboutText:"Loyola Global Works connects businesses with exceptional talent and reliable operational support, helping organizations scale through people, expertise, and technology.",contactEmail:"hello@loyolaglobalworks.com",contactPhone:"+63 912 345 6789",website:"www.loyolaglobalworks.com"},
services:[
["◯","Virtual Assistance","Administrative and executive support designed around your workflow."],
["◌","Customer Support","Reliable professionals representing your brand with care and consistency."],
["▧","Back-Office Operations","Helping businesses manage essential processes efficiently."],
["⌁","Creative Services","Design, content, and digital support for growing brands."],
["♧","Staffing & Talent Solutions","Connecting businesses with skilled professionals ready to contribute."]
],
team:[
["Christopher Loyola","Founder & CEO","People, strategy, and long-term growth."],
["Operations Lead","Operations Lead","Keeping delivery, processes, and performance moving."],
["Talent Director","Talent Director","Building exceptional teams and talent experiences."],
["Client Success","Client Success","Creating trusted partnerships and measurable outcomes."]
],
jobs:[
{id:"job-1",title:"Virtual Assistant",department:"Operations",location:"Remote · Philippines",type:"Full-time",description:"Support clients with organized, dependable day-to-day operations.",fields:[
["fullName","Full Name","text",true],["email","Email Address","email",true],["phone","Phone Number","tel",false],["resume","Resume / CV","file",true],["message","Tell us about yourself","textarea",true]]}
],
assets:{logo:"assets/logo-horizontal.png",monogram:"assets/logo-monogram-dark.png",hero:"assets/hero-lgw.png"}
};

let db=JSON.parse(localStorage.getItem("lgw_db")||"null")||DEFAULT;
let published=JSON.parse(localStorage.getItem("lgw_published")||"null")||db;
function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function save(){localStorage.setItem("lgw_db",JSON.stringify(db))}
function publish(){published=JSON.parse(JSON.stringify(db));localStorage.setItem("lgw_published",JSON.stringify(published));alert("Published in this browser. For public multi-user publishing, connect this build to a hosted database/CMS.");render()}
function render(){
 const d=published,s=d.site;
 document.title=s.company+" — "+s.tagline;
 document.getElementById("app").innerHTML=`
<header class="topbar"><div class="container nav"><a href="#home"><img class="nav-logo" src="${esc(d.assets.logo)}"></a><nav class="nav-links"><a href="#services">Services</a><a href="#about">About</a><a href="#team">Talent</a><a href="#careers">Careers</a><a href="#contact">Contact</a><a class="btn btn-light" href="#contact">Let's Work Together</a></nav><button class="mobile-toggle" onclick="alert('Use the desktop navigation for the full prototype.')">☰</button></div></header>
<main>
<section class="hero" id="home"><div class="container hero-inner"><div class="eyebrow">${esc(s.heroKicker)}</div><h1 class="serif">${esc(s.heroTitle)}</h1><p>${esc(s.heroText)}</p><div class="hero-actions"><a class="btn btn-light" href="#services">Explore Our Services <span>→</span></a><a class="btn btn-outline" href="#team">Meet Our Team <span>→</span></a></div></div></section>
<section class="section" id="services"><div class="container"><div class="intro-grid"><div><div class="section-label">What We Do</div><h2 class="serif">Global Talent.<br>Local Excellence.</h2></div><p>From day-to-day operations to specialized support, we provide the people, processes, and performance your business needs to move forward.</p></div><div class="cards">${d.services.map(x=>`<article class="card"><div class="icon">${esc(x[0])}</div><h3>${esc(x[1])}</h3><p>${esc(x[2])}</p><div class="arrow">→</div></article>`).join("")}</div></div></section>
<section class="stats"><div class="container stats-grid"><div class="stat"><div class="stat-num">150+</div><div><div class="stat-label">Global Clients</div><div class="stat-sub">Served across industries</div></div></div><div class="stat"><div class="stat-num">2,500+</div><div><div class="stat-label">Talent Professionals</div><div class="stat-sub">Working from around the world</div></div></div><div class="stat"><div class="stat-num">98%</div><div><div class="stat-label">Client Satisfaction</div><div class="stat-sub">Built on trust and performance</div></div></div><div class="stat"><div class="stat-num">10+</div><div><div class="stat-label">Years of Experience</div><div class="stat-sub">Delivering measurable results</div></div></div></div></section>
<section class="about" id="about"><div class="about-grid"><div class="about-photo"></div><div class="about-copy"><div class="section-label">About Us</div><h2 class="serif">${esc(s.aboutTitle)}</h2><p>${esc(s.aboutText)}</p><p>We connect global talent with businesses that value reliability, innovation, and long-term partnership.</p><div class="pillars"><div class="pillar"><strong>Our Mission</strong><span>To connect exceptional talent with businesses and empower growth through people.</span></div><div class="pillar"><strong>Our Vision</strong><span>To be a globally trusted partner in outsourcing and talent solutions.</span></div><div class="pillar"><strong>Our Values</strong><span>Integrity. Excellence. Collaboration. Innovation. Accountability.</span></div></div></div></div></section>
<section class="section" id="team"><div class="container"><div class="section-label">Our People</div><h2 class="serif">The people behind<br>the performance.</h2><div class="cards" style="margin-top:50px;grid-template-columns:repeat(4,1fr)">${d.team.map(t=>`<article class="card" style="min-height:230px"><div class="section-label">LGW TEAM</div><h3 style="font-size:16px;text-transform:none;letter-spacing:0">${esc(t[0])}</h3><p><strong>${esc(t[1])}</strong></p><p>${esc(t[2])}</p></article>`).join("")}</div></div></section>
<section class="careers" id="careers"><div class="container"><div class="career-head"><div><div class="section-label">Careers</div><h2 class="serif">Build your next chapter.</h2></div><p style="max-width:430px;color:#555;line-height:1.7;font-size:14px">Explore open positions at Loyola Global Works and join a team built around people, purpose, and performance.</p></div><div class="jobs">${d.jobs.length?d.jobs.map(j=>`<article class="job"><div><h3>${esc(j.title)}</h3><p>${esc(j.description)}</p></div><div class="job-meta">${esc(j.department)} · ${esc(j.location)} · ${esc(j.type)}</div><button class="btn btn-dark" onclick="openJob('${esc(j.id)}')">Apply →</button></article>`).join(""):`<p>No current openings.</p>`}</div></div></section>
<section class="dark-cta" id="contact"><div class="container cta-grid"><h2 class="serif">Let’s build something<br>great together.</h2><p>Partner with us and experience the difference of working with a team that's invested in your success.</p><a class="btn btn-light" href="mailto:${esc(s.contactEmail)}">Let's Work Together →</a></div></section>
</main>
<footer class="footer"><div class="container footer-grid"><div><img class="footer-logo" src="${esc(d.assets.logo)}"><p style="margin-top:15px">CONNECTING TALENT. POWERING BUSINESS.</p></div><div><h4>Quick Links</h4><a href="#home">Home</a><a href="#services">Services</a><a href="#about">About</a><a href="#team">Talent</a><a href="#careers">Careers</a></div><div><h4>Services</h4>${d.services.map(x=>`<a href="#services">${esc(x[1])}</a>`).join("")}</div><div><h4>Contact Us</h4><p>${esc(s.contactEmail)}</p><p>${esc(s.contactPhone)}</p><p>${esc(s.website)}</p></div></div><div class="container copyright">© ${new Date().getFullYear()} Loyola Global Works. All Rights Reserved.</div></footer>
<div class="modal" id="jobModal"><div class="modal-box" id="jobBox"></div></div>`;
}
function openJob(id){const j=published.jobs.find(x=>x.id===id);if(!j)return;document.getElementById("jobBox").innerHTML=`<h2 class="serif">${esc(j.title)}</h2><p style="color:#666;line-height:1.7">${esc(j.description)}</p><form onsubmit="submitApplication(event,'${esc(j.id)}')">${j.fields.map(f=>`<div class="form-row"><label>${esc(f[1])}${f[3]?" *":""}</label>${f[2]==="textarea"?`<textarea name="${esc(f[0])}" ${f[3]?"required":""}></textarea>`:f[2]==="select"?`<select name="${esc(f[0])}" ${f[3]?"required":""}><option value="">Select</option><option>Yes</option><option>No</option></select>`:`<input type="${esc(f[2])}" name="${esc(f[0])}" ${f[3]?"required":""}>`}</div>`).join("")}<div class="modal-actions"><button class="btn btn-dark">Submit Application</button><button type="button" class="btn" onclick="closeJob()">Close</button></div></form>`;document.getElementById("jobModal").classList.add("show")}
function closeJob(){document.getElementById("jobModal").classList.remove("show")}
function submitApplication(e,id){e.preventDefault();const fd=new FormData(e.target),values={};fd.forEach((v,k)=>values[k]=v.name||v);const apps=JSON.parse(localStorage.getItem("lgw_apps")||"[]");apps.push({jobId:id,submitted:new Date().toISOString(),values});localStorage.setItem("lgw_apps",JSON.stringify(apps));alert("Application received. Thank you.");closeJob()}
render();
